{
    "model": "XGBoost",
    "model_type": "Leakage-Safe Temporal XGBoost",
    "n_features": 10,
    "features": [
        "step",
        "amount",
        "oldbalanceOrg",
        "oldbalanceDest",
        "amount_to_oldbalance_ratio",
        "amount_to_dest_balance_ratio",
        "type_CASH_OUT",
        "type_DEBIT",
        "type_PAYMENT",
        "type_TRANSFER"
    ],
    "threshold": 0.9,
    "objective": "binary:logistic",
    "n_estimators": 300
}